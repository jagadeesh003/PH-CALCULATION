
body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.container {
    background: white;
    padding: 35px;
    width: 320px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

h1 {
    color: #0072ff;
}

input {
    width: 90%;
    padding: 12px;
    margin: 15px 0;
    border: 1px solid #aaa;
    border-radius: 8px;
    font-size: 16px;
}

button {
    background: #0072ff;
    color: white;
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #0055cc;
}

#result {
    margin-top: 20px;
    font-size: 18px;
    font-weight: bold;
}
