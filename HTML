
<!DOCTYPE html>
<html>
<head>
    <title>Water pH Testing</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>💧 Water pH Testing</h1>
        <p>Check the pH level of your water</p>

        <input type="number" id="phValue"
        placeholder="Enter pH value (0-14)" min="0" max="14" step="0.1">

        <button onclick="checkPH()">Check pH</button>

        <div id="result"></div>
    </div>

    <script src="script.js"></script>
</body>
</html>
